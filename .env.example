# Genius API Credentials
# Get your Client ID/Secret at https://genius.com/api-clients
CLIENT_ID=
CLIENT_SECRET=

# Alternatively, use a direct Access Token
GENIUS_TOKEN=

# DeepL API Credentials
# Get your Free/Pro key at https://www.deepl.com/pro-api
DEEPL_API_KEY=

# OpenAI API Credentials
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Translation Backend Selection
# Options: "deepl" | "openai"
TRANSLATION_BACKEND=deepl
